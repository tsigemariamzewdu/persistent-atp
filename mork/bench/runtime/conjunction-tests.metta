!(add-atom &mork (a "p" "x"))
!(add-atom &mork (a "p" "y"))
!(add-atom &mork (a "other" "z"))
!(add-atom &mork (b "x" "one"))
!(add-atom &mork (b "x" "two"))
!(add-atom &mork (b "y" "three"))
!(add-atom &mork (b "z" "excluded"))
!(mork-flush &mork)
!(println! (EMPTY (collapse (match &mork (,) identity))))
!(println! (SINGLE (collapse (match &mork (, (a "p" $x)) $x))))
!(println! (JOIN (collapse (match &mork (, (a "p" $x) (b $x $y)) ($x $y)))))
!(println! (ABSENT (collapse (match &mork (, (a "p" $x) (b $x "missing")) $x))))
!(println! (REVERSE (collapse (match &mork (, (b $x "two") (a $proof $x)) ($proof $x)))))
