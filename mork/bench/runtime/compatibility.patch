 %Remove all same atoms:
 'remove-atom'('&mork', Atom, true) :- !, swrite(Atom, S),
                                          mork("remove-atoms", S, _).
+
+% Compatibility for PeTTa's conjunctive match: the native API accepts one
+% pattern, so evaluate conjuncts in order while sharing Prolog bindings.
+match('&mork', [','|Patterns], OutPattern, Result) :- !,
+    mork_match_conjunction(Patterns),
+    Result = OutPattern.
+mork_match_conjunction([]).
+mork_match_conjunction([Pattern|Rest]) :-
+    match('&mork', Pattern, Pattern, _),
+    mork_match_conjunction(Rest).
 
